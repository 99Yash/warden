---
import type { CommentSet } from "@warden/core";
import fixture from "../fixtures/warden-on-warden.json";

const commentSet = fixture as CommentSet;
const heroComments = commentSet.comments.slice(0, 3);
---

<section class="hero-demo" aria-label="Warden review output preview">
  <div class="terminal-window">
    <div class="terminal-bar" aria-hidden="true">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="terminal-title">warden — opencode-review</span>
    </div>
    <div class="terminal-body">
      <p class="prompt">
        <span class="prompt-sym">$</span><span class="prompt-cmd">warden opencode-review</span>
        <span class="prompt-flag">--base main</span>
      </p>
      <p class="phase ok"><span class="phase-tag">ok</span><span>mcp: warden connected · run_det_priors, lookup_type_def</span></p>
      <p class="phase ok"><span class="phase-tag">ok</span><span>det-priors: tsc, eslint, audit + OSV, jscpd, security lint</span></p>
      <p class="phase ok"><span class="phase-tag">ok</span><span>lane down · correctness · OpenCode, read-only tools</span></p>
      <p class="phase ok"><span class="phase-tag">ok</span><span>post-pass: citations verified, scoped to diff, cap 5</span></p>
      <p class="phase active"><span class="phase-tag">..</span><span>publishing CommentSet</span></p>
      <div class="finding-list">
        {
          heroComments.map((comment) => (
            <article class={`mini-finding tier-${comment.tier}`}>
              <p class="mini-meta">
                <span class="tier-pill">T{comment.tier}</span>
                <span>{comment.category}</span>
                <span>{Math.round(comment.confidence * 100)}%</span>
              </p>
              <p class="mini-file">
                {comment.file}:{comment.lineStart}
              </p>
              <p class="mini-claim">{comment.claim}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
