{
  // Every lint fence in this repo lives in THIS file. oxlint resolves the nearest config, so a
  // second .oxlintrc.json below the root would replace this one for its whole subtree and leave
  // `pnpm lint` green; the lint scripts pin `--config .oxlintrc.json` so a nested config is inert.
  // Narrow a rule with an "overrides" entry below, never with a nested config file.
  //
  // The bar for a rule at "error" (docs/gate-design.md): the tree is at zero for it. A rule the
  // tree still violates is either "off" with its measured count and a pointer to the ratchet
  // queue, or it is driven to zero first, in its own change. A rule at "warn" enforces nothing
  // on its own; `pnpm lint` passes `--deny-warnings` so a default-category warning cannot
  // accumulate either.
  //
  // `plugins` REPLACES oxlint's default set, so it restates that set (eslint, typescript,
  // unicorn, oxc) and then adds the plugins this file opts in to. A plugin dropped from this
  // list turns every rule below that it owns into a silent no-op.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "node", "import"],
  "jsPlugins": ["./scripts/oxlint/anti-slop/index.ts", "./scripts/oxlint/warden/index.ts"],
  "categories": {},
  "options": {
    "typeAware": true
  },
  "rules": {
    // The vendored anti-slop rules (scripts/oxlint/anti-slop/README.md). Every registered rule
    // is listed here, "error" or "off"; `pnpm check:oxlint-plugin` fails on one that is not,
    // and drives every "error" rule through this file to prove it reports.
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-chained-type-assertions": "error",
    // Ratchet queue — counts measured 2026-10-18 as product src / scripts. Each moves to
    // "error" in its own change once the tree is at zero. See docs/gate-design.md.
    "anti-slop/no-unknown-returns": "off", // 6 / 3
    "anti-slop/no-known-value-widening": "off", // 42 / 18
    "anti-slop/no-unsafe-dictionary-type": "off", // 50 / 32
    "anti-slop/no-runtime-typeof": "off", // 75 / 42 (with allowInTypeGuards)
    "anti-slop/require-readable-spacing": "off", // 4375, whitespace-only autofix; a style decision

    // Warden's own rules (scripts/oxlint/warden/, first-party, see its README). Each keeps
    // its file scope by itself (`shared/scope.ts`), so none needs an "overrides" entry.
    // sha256-over-json-stringify: a hash digest over JSON.stringify output, whose pre-image
    // depends on key order; hash sha256Hex(canonicalJson(value)). no-exported-hasher: a
    // function outside @warden/core/hash that is exported and hashes its parameter, which
    // keeps the set of cross-file hashers closed for the sha256 rule.
    "warden/no-exported-hasher": "error",
    "warden/sha256-over-json-stringify": "error",

    // Type-aware rules, run through tsgolint (`options.typeAware`).
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/no-explicit-any": "error",
    // no-non-null-assertion: a postfix `!` is a runtime promise the compiler cannot keep. Keep
    // the narrowing instead (destructure, `.at(-1)` plus a check, `for…of` over `entries()`, a
    // local). When absence is impossible, throw an `Error` that names the invariant; when it is
    // possible, handle it. Never trade `!` for `as T`. Scripts included, no override.
    "typescript/no-non-null-assertion": "error",
    // no-deprecated: a use of a symbol whose declaration carries `@deprecated`, from a
    // dependency (zod 4, the AI SDK, the TypeScript API, drizzle, the MCP SDK) or from this
    // repo. Migrate to the replacement the tag names. A site that must keep the old symbol
    // carries a directive with the reason (`packages/mcp/src/server.ts` keeps the low-level
    // MCP `Server`).
    "typescript/no-deprecated": "error",
    // no-unnecessary-type-assertion: an `as T` or `<T>` that does not change the type, an
    // `as T` where the context already expects `T` and the value fits it, and a `!` on a
    // value that is never null or undefined. Delete the assertion; when it was the only place
    // a reader learned the type, annotate the binding or the return type instead. A comment
    // that explained the deleted cast goes with it. It applies to every surface, with no
    // override.
    "typescript/no-unnecessary-type-assertion": "error",
    // The no-unsafe-* family. The family says that an `any` may not flow into a return, an
    // argument, a call, a member read, or an assignment; a member not listed here is still
    // off, and lands once the tree is at zero for it. Type external, persisted, and protocol
    // data as `unknown` and parse it at the owning boundary (docs/conventions.md §2) instead
    // of letting `any` carry it on. Do not swap the `any` for an `as T`: give the value a
    // type that it provably has (a zod parse, a `: unknown` binding, a type guard). The
    // family is off for JavaScript sources in the last "overrides" entry; JSDoc-typed `.mjs`
    // is `any` by construction.
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "unicorn/no-useless-spread": "error",
    // no-empty: an empty block, an empty `catch {}` included (`allowEmptyCatch` stays false).
    // A `catch` handles the failure, logs safe fields, or holds a comment that says why the
    // failure is safe to drop. A comment inside the block counts as content.
    "no-empty": "error",
    // return-await, correctness option only: a promise returned without `await` inside a `try`
    // (or a `catch` that has a `finally`) settles after the block exits, so its `catch` never
    // sees the rejection and its `finally` runs too early. Write `return await`. The default
    // option also asks for style edits outside a `try`, and those change no behavior.
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    // only-throw-error: a `throw` of a value that is not an `Error` has no stack and no
    // `message`. Throw an `Error` (or a subclass). A caught `unknown` may be rethrown as it is
    // (the rule's defaults).
    "typescript/only-throw-error": "error",
    // consistent-type-imports: an import used only as a type, including only inside `typeof`,
    // takes `type`. `verbatimModuleSyntax` already fails `tsc` on a type imported without it,
    // but a value imported only for `typeof` compiles and stays in the runtime import graph.
    // `fixStyle` matches the tree: a mixed import marks each type inline. The fixer then
    // writes `import { type X }` for a declaration whose every name is a type; rewrite that as
    // `import type { X }`, because the inline form keeps a side-effect import of the module.
    // `disallowTypeAnnotations` is off: an `import("…")` type is erased, so it costs nothing
    // at runtime.
    "typescript/consistent-type-imports": [
      "error",
      { "disallowTypeAnnotations": false, "fixStyle": "inline-type-imports" }
    ],
    // Default `correctness` rules, each at zero when it landed, default options. The default
    // category arms them at "warn", which `--deny-warnings` already fails; "error" states the
    // fence here, so it does not depend on the category default.
    // - await-thenable: an `await` of a value that is not a promise. Remove the `await`.
    // - no-array-delete: `delete xs[i]` leaves a hole. Use `splice` or `filter`.
    // - no-for-in-array: `for…in` over an array walks string keys. Use `for…of`.
    // - no-implied-eval: a string passed to `setTimeout` / `new Function` is `eval`. Pass a
    //   function.
    // - no-unsafe-unary-minus: unary minus on a value that is not a number or bigint.
    // - no-useless-default-assignment: a default for a binding that is never `undefined`.
    //   Delete the default, or widen the type if `undefined` can arrive.
    // - no-meaningless-void-operator: `void` on an expression that is already `void`.
    // - no-misused-spread: a spread of a string, a promise, or a class instance. Split a
    //   string into code points with `Array.from`, which states the intent.
    // - no-duplicate-type-constituents: a union or intersection that repeats a member. It
    //   also reports `| undefined` on an optional PARAMETER; an optional property keeps it,
    //   because `exactOptionalPropertyTypes` is on.
    // - no-redundant-type-constituents: a union member another member absorbs
    //   (`unknown | X`, `"a" | string`). Write the wide type and say the rest in the doc
    //   comment, or derive the exact union.
    // - require-array-sort-compare: `.sort()` with no comparator orders numbers, tuples and
    //   objects by their string form. Pass a comparator. `ignoreStringArrays` stays on (its
    //   default): a `string[]` sorts by UTF-16 code unit, which is deterministic.
    // - no-base-to-string: `String(v)` or a template on a value that may be an object prints
    //   `[object Object]`. Narrow the value at its boundary, or pick the text you mean
    //   (`JSON.stringify` of a JSON value, `error.message`).
    // - unbound-method: a method read as a value loses `this`. Bind it or wrap it in an
    //   arrow; declare a member that never reads `this` as a function-typed property.
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-useless-default-assignment": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/no-base-to-string": "error",
    "typescript/unbound-method": "error",
    // The import plugin's two default `correctness` rules had zero hits when it landed, so
    // they are set to "error" here instead of the "warn" that the plugin arms them at.
    // import/default: a default import from a module that has no default export.
    // import/namespace: `ns.x` on a namespace import whose module does not export `x`.
    "import/default": "error",
    "import/namespace": "error",
    // import/no-cycle: a module that reaches itself again through its imports. ESM loads a
    // cycle without an error, but a binding read during module evaluation can be in its TDZ,
    // and the order of `export` lines then decides whether the process boots. It resolves
    // relative and `@warden/*` specifiers alike. It skips type-only imports, the inline
    // `{ type X }` form too, although that form keeps a runtime import under
    // verbatimModuleSyntax. Break a cycle by moving the shared piece into a module that both
    // sides import, or by importing a concrete sibling instead of a barrel.
    "import/no-cycle": "error",

    // A `catch` that throws a new error must pass the caught one as `{ cause }`, so the stack
    // and the original failure survive the rewrap. Default options.
    "preserve-caught-error": "error",

    // `warden mcp` speaks JSON-RPC over stdio, so a stray console.log in product code
    // corrupts the protocol stream. Product code writes through process.stdout/stderr on
    // purpose; scripts are exempt below.
    "no-console": "error",

    // Read configuration through @warden/env (docs/environment.md), never process.env.
    // packages/env is the owner and is exempt below. A deliberate exception elsewhere takes
    // `// oxlint-disable-next-line node/no-process-env -- <why>`.
    "node/no-process-env": "error",

    // Model selection goes through @warden/ai (getBossModel / getWorkerStrongModel /
    // getWorkerCheapModel, ADR-0006). packages/ai is the one owner of provider packages
    // and is exempt below. The `ai` package itself (streamText, tool, Output) is allowed.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@ai-sdk/*"],
            "message": "Provider packages are owned by @warden/ai. Get a model from getBossModel() / getWorkerStrongModel() / getWorkerCheapModel() instead (docs/conventions.md, ADR-0006)."
          }
        ]
      }
    ]
  },
  "settings": {
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist/**",
    "**/migrations/**",
    "**/.warden/**",
    // Vendored verbatim; proven by `pnpm check:oxlint-plugin`, not by linting its source.
    "scripts/oxlint/anti-slop/**"
  ],
  "overrides": [
    {
      // The env owner reads process.env by definition.
      "files": ["packages/env/src/**"],
      "rules": { "node/no-process-env": "off" }
    },
    {
      // The provider owner.
      "files": ["packages/ai/src/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // Smoke scripts, probes, evals and repo tooling: they print to the terminal and
      // set up child-process environments directly.
      "files": ["**/scripts/**", ".claude/hooks/**"],
      "rules": { "no-console": "off", "node/no-process-env": "off" }
    },
    {
      // The no-unsafe-* family stays off ON PURPOSE for JavaScript sources, as in alfred. The
      // gate scripts are JSDoc-typed `.mjs` checked with `noImplicitAny: false`
      // (scripts/tsconfig.json), and `.claude/hooks/*.mjs` are in no tsconfig at all, so an
      // unannotated binding, a parsed manifest, or a Node global is `any` there by
      // construction. On 2026-10-20 the family reported 294 such reads in `.mjs`, none of
      // them an escaped boundary. TypeScript sources everywhere, scripts included, keep each
      // rule that is on. The four that are still "off" above are listed here already, so a
      // rule that lands later needs no second override.
      "files": ["**/*.mjs", "**/*.js", "**/*.cjs"],
      "rules": {
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off"
      }
    }
  ]
}
