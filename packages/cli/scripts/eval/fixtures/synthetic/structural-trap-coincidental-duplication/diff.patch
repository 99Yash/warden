@@ -0,0 +1,8 @@
+/**
+ * Ticket numbers as the support inbox shows them: "TKT-" and the sequence,
+ * zero-padded to 6 digits. A display choice of the support team; they can
+ * change the prefix or the width at any time.
+ */
+export function formatTicketNumber(sequence: number): string {
+  return `TKT-${String(sequence).padStart(6, "0")}`;
+}
