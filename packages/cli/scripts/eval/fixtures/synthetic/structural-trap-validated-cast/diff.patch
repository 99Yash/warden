@@ -0,0 +1,12 @@
+export const REGIONS = ["us-east", "eu-west", "ap-south"] as const;
+export type Region = (typeof REGIONS)[number];
+
+/**
+ * The one place a string becomes a `Region`. `includes` on a readonly tuple
+ * does not narrow its argument, so the cast sits here, right after the
+ * membership check that proves it.
+ */
+export function parseRegion(raw: string): Region | undefined {
+  const known: readonly string[] = REGIONS;
+  return known.includes(raw) ? (raw as Region) : undefined;
+}
