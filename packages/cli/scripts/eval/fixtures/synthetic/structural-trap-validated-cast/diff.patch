@@ -0,0 +1,15 @@
+import { parseRegion, REGIONS, type Region } from "./region";
+
+export interface AppConfig {
+  region: Region;
+}
+
+/** Read the app config from the environment. Throws on a value it does not know. */
+export function loadConfig(env: Record<string, string | undefined>): AppConfig {
+  const raw = env["APP_REGION"] ?? "us-east";
+  const region = parseRegion(raw);
+  if (region === undefined) {
+    throw new Error(`APP_REGION must be one of ${REGIONS.join(", ")} (got "${raw}")`);
+  }
+  return { region };
+}
diff --git a/src/config/region.ts b/src/config/region.ts
