@@ -0,0 +1,18 @@
+import type { SmtpMailer } from "../notify/smtp-mailer";
+
+export interface NewAccount {
+  email: string;
+  displayName: string;
+}
+
+/**
+ * Send the welcome email for a new account. Takes only `send`, so a test can
+ * pass a fake without an SMTP server.
+ */
+export async function sendWelcomeEmail(
+  mailer: Pick<SmtpMailer, "send">,
+  account: NewAccount,
+): Promise<void> {
+  const text = `Hi ${account.displayName},\n\nYour account is ready.\n`;
+  await mailer.send({ to: account.email, subject: "Welcome", text });
+}
