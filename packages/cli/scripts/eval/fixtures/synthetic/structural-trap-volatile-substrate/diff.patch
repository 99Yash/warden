+++ b/src/sms/reminder.ts
@@ -0,0 +1,14 @@
+import { formatReminderTime } from "./time";
+
+export interface Appointment {
+  startsAt: Date;
+  /** The client's UTC offset at `startsAt`, in minutes (from their saved time zone). */
+  utcOffsetMinutes: number;
+  clinicName: string;
+}
+
+/** The reminder SMS text. GSM-7 only, so one message stays one segment. */
+export function reminderText(appointment: Appointment): string {
+  const time = formatReminderTime(appointment.startsAt, appointment.utcOffsetMinutes);
+  return `Reminder: your visit at ${appointment.clinicName} is today at ${time}. Reply C to cancel.`;
+}
