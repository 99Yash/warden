@@ -0,0 +1,20 @@
+import { slugify } from "../utils/strings";
+
+export interface CsvFile {
+  filename: string;
+  body: string;
+}
+
+/**
+ * Quote one field for RFC 4180: wrap it in double quotes when it holds a
+ * comma, a double quote, or a line break, and double each quote inside it.
+ */
+function escapeCsvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value;
+}
+
+/** A CSV download: a header row, then one line per row, CRLF line ends. */
+export function toCsv(title: string, header: string[], rows: string[][]): CsvFile {
+  const lines = [header, ...rows].map((row) => row.map(escapeCsvField).join(","));
+  return { filename: `${slugify(title)}.csv`, body: `${lines.join("\r\n")}\r\n` };
+}
